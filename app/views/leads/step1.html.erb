<div class="container">
  <h2>Get Your Instant Insurance Quote</h2>

  <div class="progress-container">
    <div class="step active">
      <div class="circle">1</div>
      <div class="step-label">Basic Info</div>
    </div>

    <div class="step">
      <div class="circle">2</div>
      <div class="step-label">Details</div>
    </div>

    <div class="step">
      <div class="circle">3</div>
      <div class="step-label">Quotes</div>
    </div>
  </div>

  <%= form_with url: "/step1", method: :post do %>

    <label>Vehicle Registration Number</label>
    <%= text_field_tag :vehicle_reg, nil, placeholder: "DL09CA1234", required: true, pattern: "[A-Z]{2}[0-9]{1,2}[A-Z]{2,3}[0-9]{4}" %>

    <label>Mobile Number</label>
    <%= text_field_tag :mobile, nil, placeholder: "Enter 10-digit number", required: true, pattern: "[6-9]{1}[0-9]{9}" %>

    <%= hidden_field_tag :hidden_field %>

    <%= submit_tag "Continue", class: "btn" %>

  <% end %>
</div>
