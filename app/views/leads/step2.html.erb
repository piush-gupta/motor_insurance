<div class="container">
  <h2>Help Us Refine Your Quote</h2>

  <% if flash[:errors] %>
    <div class="error">
      <% flash[:errors].each do |e| %>
        <p><%= e %></p>
      <% end %>
    </div>
  <% end %>

  <div class="progress-container">
    <div class="step completed">
      <div class="circle">✓</div>
      <div class="step-label">Basic Info</div>
    </div>

    <div class="step active">
      <div class="circle">2</div>
      <div class="step-label">Details</div>
    </div>

    <div class="step">
      <div class="circle">3</div>
      <div class="step-label">Quotes</div>
    </div>
  </div>

  <%= form_with url: "/step2", method: :post do %>
    <label>Previous Policy Expiry Date</label>
    <%= date_field_tag :previous_policy_expiry_date, nil, required: true %>

    <label>IDV Preference</label>
    <%= select_tag :idv_preference,
          options_for_select([
            ["Low (Lower premium)", "low"],
            ["Medium (Balanced)", "medium"],
            ["High (Maximum coverage)", "high"]
          ]),
          required: true %>

    <label>No Claim Bonus (NCB)</label>
    <%= select_tag :ncb, options_for_select(["0%", "20%", "25%", "30%"]) %>

    <label>Number of Claims</label>
    <%= select_tag :claims, options_for_select(["0", "1","2", "2+"]) %>

    <%= submit_tag "View Quotes", class: "btn" %>

  <% end %>
</div>
