<div class="container">
  <h2>Available Insurance Quotes</h2>

  <% cheapest = @quotes.min_by { |q| q[:amount] } %>

  <% @quotes.each do |quote| %>
    <div class="quote-card <%= 'best' if quote == cheapest %>">
      
      <div class="quote-header">
        <strong><%= quote[:insurance_provider] %></strong>
        <% if quote == cheapest %>
          <span class="badge">Best Price</span>
        <% end %>
      </div>

      <div class="quote-amount">
        ₹<%= quote[:amount] %>
      </div>

      <button class="btn">Buy Now</button>
    </div>
  <% end %>

  <br>
  <%= link_to "⬅ Start New Quote", root_path, class: "btn-back" %>

</div>
